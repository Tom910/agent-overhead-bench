index 0000000..db936d3
--- /dev/null
+++ b/internal/runtime/executor/aob_meter.go
@@ -0,0 +1,68 @@
+package executor
+
+import (
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// aobMeterEndpoint is a private, explicit OAuth instrumentation opt-in.
+// It does not reinterpret a provider URL or change OAuth credential ownership.
+func aobMeterEndpoint(auth *cliproxyauth.Auth) (string, bool, error) {
+	if auth == nil || auth.Metadata == nil {
+		return "", false, nil
+	}
+	raw, present := auth.Metadata["aob_meter_base_url"]
+	if !present {
+		return "", false, nil
+	}
+	invalid := func() (string, bool, error) {
+		return "", true, statusErr{code: http.StatusBadRequest, msg: "invalid local Codex metering configuration"}
+	}
+	value, ok := raw.(string)
+	if !ok || value == "" || strings.TrimSpace(value) != value || strings.ContainsAny(value, "?#") {
+		return invalid()
+	}
+	endpoint, err := url.Parse(value)
+	if err != nil || endpoint.Scheme != "http" || endpoint.Opaque != "" || endpoint.User != nil || endpoint.Path != "" || endpoint.RawPath != "" || endpoint.RawQuery != "" || endpoint.Fragment != "" || endpoint.ForceQuery {
+		return invalid()
+	}
+	if endpoint.Hostname() != "127.0.0.1" && endpoint.Hostname() != "localhost" {
+		return invalid()
+	}
+	port := endpoint.Port()
+	number, err := strconv.Atoi(port)
+	if err != nil || number < 1 || number > 65535 || strconv.Itoa(number) != port {
+		return invalid()
+	}
+	if auth.Provider != "codex" || codexAuthUsesAPIKey(auth) {
+		return invalid()
+	}
+	capability := ""
+	for key, value := range auth.Attributes {
+		if strings.EqualFold(key, "header:x-aob-proxy-token") {
+			if capability != "" {
+				return invalid()
+			}
+			capability = value
+		}
+	}
+	if len(capability) < 32 || len(capability) > 256 {
+		return invalid()
+	}
+	for _, c := range capability {
+		if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-') {
+			return invalid()
+		}
+	}
+	return endpoint.String(), true, nil
+}
+func aobMeterUnsupportedTransport() error {
+	return statusErr{code: http.StatusBadRequest, msg: "Codex metering supports HTTP Responses only"}
+}
+func aobMeterDisableRedirects(client *http.Client) {
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+}
diff --git a/internal/runtime/executor/aob_meter_test.go b/internal/runtime/executor/aob_meter_test.go
