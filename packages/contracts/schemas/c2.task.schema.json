{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "C2TaskYaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "language", "size", "shape", "timeout_s", "expected_minutes", "description"],
  "properties": {
    "id": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "revision", "task_id", "license_notes"],
      "properties": {
        "kind": { "type": "string" },
        "repository": { "type": "string" },
        "revision": { "type": "string" },
        "task_id": { "type": "string" },
        "license_notes": { "type": "string" },
        "base_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "language": { "enum": ["python", "typescript", "go", "javascript", "rust"] },
    "size": { "enum": ["small", "medium"] },
    "shape": { "enum": ["bugfix", "test-fix", "feature", "refactor"] },
    "timeout_s": { "type": "number", "exclusiveMinimum": 0 },
    "expected_minutes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": 0 }
    },
    "description": { "type": "string" }
  }
}
